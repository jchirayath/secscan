# secscan configuration.
#
# Generated by `secscan config -example` from the config registry, so this
# file cannot drift from what the binary actually reads.
#
# Copy to .env (gitignored) and fill in. Never commit a filled-in copy:
# the session and client secrets are what stand between a stranger and
# your dashboard.

# Comma-separated emails granted admin
SECSCAN_ADMIN_EMAILS=

# Comma-separated email domain allow-list
SECSCAN_ALLOWED_DOMAINS=

# entra | proxy | local
SECSCAN_AUTH_MODE=local

# External base URL, e.g. https://scan.example.com
SECSCAN_BASE_URL=

# Listen address for `serve`
SECSCAN_BIND=127.0.0.1:8788

# Entra application (client) ID
# required when SECSCAN_AUTH_MODE=entra
SECSCAN_ENTRA_CLIENT_ID=

# Entra client secret
# SECRET — do not commit a real value
# required when SECSCAN_AUTH_MODE=entra
SECSCAN_ENTRA_CLIENT_SECRET=CHANGE_ME

# Entra directory (tenant) ID
# required when SECSCAN_AUTH_MODE=entra
SECSCAN_ENTRA_TENANT_ID=

# State directory (default ~/.secscan)
SECSCAN_HOME=

# Outbound HTTP timeout
SECSCAN_HTTP_TIMEOUT=30s

# debug | info | warn | error
SECSCAN_LOG_LEVEL=info

# Per-collector timeout
SECSCAN_SCAN_TIMEOUT=5m

# HMAC key for session cookies (>=32 bytes)
# SECRET — do not commit a real value
# required when SECSCAN_AUTH_MODE=entra
SECSCAN_SESSION_SECRET=CHANGE_ME

# Session lifetime
SECSCAN_SESSION_TTL=8h

# Where per-scan snapshots are written (default $SECSCAN_HOME/snapshots)
SECSCAN_SNAPSHOT_DIR=

# Snapshots to retain per asset; 0 keeps everything
SECSCAN_SNAPSHOT_KEEP=0

# SSH connect timeout
SECSCAN_SSH_TIMEOUT=20s

# CIDRs allowed to assert identity headers (proxy mode)
SECSCAN_TRUSTED_PROXIES=

